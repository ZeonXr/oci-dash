# Optional settings for the standalone release compose.yaml. No .env is required.
# The downloaded Compose file works without this template or a source checkout.
# PORT=3000
# DATA_PATH=app-data
# Use a host directory outside the repository/build context, preferably absolute:
# DATA_PATH=/opt/oci-dash-data
# Linux directories/files must be accessible to UID/GID 1000:1000.
# Stop and migrate all existing data before changing DATA_PATH.
# Keep the existing Compose project name and app-data volume when upgrading.
# These values configure host mappings; they are not injected into the container.
# Directory preparation, migration and advanced overrides:
# https://github.com/ZeonXr/oci-dash/blob/main/docs/OPERATIONS.md
