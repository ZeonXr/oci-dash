{
  "name": "oci-dash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted OCI management console built with Next.js and TypeScript.",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && npm run build:runtime",
    "build:runtime": "esbuild src/runtime.ts src/health.ts src/worker.ts src/worker-health.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --out-extension:.js=.mjs",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx --env-file=.env src/worker.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:runtime": "node scripts/verify-runtime.mjs",
    "bootstrap": "node scripts/bootstrap.mjs"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "oci-common": "2.145.0",
    "oci-core": "2.145.0",
    "oci-identity": "2.145.0",
    "oci-limits": "2.145.0",
    "oci-monitoring": "2.145.0",
    "oci-usageapi": "2.145.0",
    "otpauth": "9.6.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24",
    "@types/novnc__novnc": "1.6.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
