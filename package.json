{
  "name": "oci-dash",
  "version": "0.6.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A self-hosted OCI management console built with Next.js and TypeScript.",
  "engines": {
    "node": ">=26.13 <27"
  },
  "scripts": {
    "dev": "node --import tsx src/runtime.ts --dev",
    "build": "next build && npm run build:runtime",
    "build:runtime": "esbuild src/runtime.ts src/health.ts src/check-data.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --out-extension:.js=.mjs",
    "start": "node dist/runtime.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --project scripts/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "node scripts/verify-e2e.ts",
    "test:runtime": "node scripts/verify-runtime.ts",
    "test:backup": "node scripts/verify-backup.ts",
    "test:release": "node scripts/verify-release.ts",
    "backup": "node scripts/backup.ts"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "oci-common": "2.145.0",
    "oci-core": "2.145.0",
    "oci-identity": "2.145.0",
    "oci-limits": "2.145.0",
    "oci-monitoring": "2.145.0",
    "oci-usageapi": "2.145.0",
    "otpauth": "9.6.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/novnc__novnc": "1.6.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
